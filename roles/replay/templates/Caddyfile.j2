# Caddyfile for BAR Replay Server (bar-rts.com)
{
	default_sni {{ domain_name_replay }}
}

{{ domain_name_replay }} {
	# Frontend - serve the Nuxt.js application
	reverse_proxy bar-live-services.dns.podman:3000

	# API routes - proxy to bar-db backend
	handle /api/* {
		reverse_proxy bar-db.dns.podman:3001
	}

	# Direct backend routes that the frontend expects
	handle /replays* {
		reverse_proxy bar-live-services.dns.podman:3000
	}
	handle /battles* {
		reverse_proxy bar-live-services.dns.podman:3000
	}
	handle /leaderboards* {
		reverse_proxy bar-live-services.dns.podman:3000
	}
	handle /maps* {
		reverse_proxy bar-live-services.dns.podman:3000
	}

	# Health check endpoint
	handle /health {
		respond "OK" 200
	}

	# Logging
	log {
		output stdout
		format console
	}
}

# API subdomain (optional, for direct API access)
{% if domain_name_api is defined %}
{{ domain_name_api }} {
	reverse_proxy bar-db.dns.podman:3001

	log {
		output stdout
		format console
	}
}
{% endif %}
